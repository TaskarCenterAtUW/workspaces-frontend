{
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": ["/_nuxt/*"]
    },
    "routes": [
        {
            "route": "/_nuxt/builds/*",
            "headers": {
                "cache-control": "no-cache"
            }
        },
        {
            "route": "/_nuxt/*",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            }
        }
    ]
}
